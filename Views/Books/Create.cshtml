@model Library2.Models.Book

@{
    ViewData["Title"] = "Добавить книгу";
}

<h1>Добавить книгу</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PublisherId" class="control-label"></label>
                <select asp-for="PublisherId" class="form-control" asp-items="ViewBag.Publishers">
                    <option value="">-- Выберите издательство --</option>
                </select>
                <span asp-validation-for="PublisherId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Авторы</label>
                <div>
                    @foreach (var author in ViewBag.Authors)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedAuthors" value="@author.IdAuthor" id="author_@author.IdAuthor">
                            <label class="form-check-label" for="author_@author.IdAuthor">
                                @author.LastName @author.FirstName
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Жанры</label>
                <div>
                    @foreach (var genre in ViewBag.Genres)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedGenres" value="@genre.IdGenre" id="genre_@genre.IdGenre">
                            <label class="form-check-label" for="genre_@genre.IdGenre">
                                @genre.Name
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Добавить</button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>