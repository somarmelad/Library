@model Library2.Models.Book
@{
    ViewData["Title"] = "Редактировать книгу";
}

<h1>Редактировать книгу</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdBook" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PublisherId" class="control-label"></label>
                <select asp-for="PublisherId" class="form-control" asp-items="@ViewBag.Publishers">
                    <option value="">-- Выберите издательство --</option>
                </select>
                <span asp-validation-for="PublisherId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Авторы (выберите одного или нескольких)</label>
                <select multiple="multiple" name="selectedAuthors" asp-items="@ViewBag.Authors" class="form-control" size="5">
                    <option value="">-- Выберите авторов --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            
            <div class="form-group mb-3">
                <label asp-for="Annotation" class="control-label"></label>
                <textarea asp-for="Annotation" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Annotation" class="text-danger"></span>
            </div>
          

            <div class="form-group mb-3">
                <label class="control-label">Жанры (выберите один или несколько)</label>
                <select multiple="multiple" name="selectedGenres" asp-items="@ViewBag.Genres" class="form-control" size="5">
                    <option value="">-- Выберите жанры --</option>
                </select>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}