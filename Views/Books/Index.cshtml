@model IEnumerable<Library2.Models.Book>

@{
    ViewData["Title"] = "Книги";
}

<h1>Книги</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Авторы</th>
            <th>Жанры</th>
            <th>Издательство</th>
            <th>Количество</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>
                    @foreach (var author in item.BookAuthors)
                    {
                        <span class="badge bg-secondary">@author.Author.LastName @author.Author.FirstName</span>
                    }
                </td>
                <td>
                    @foreach (var genre in item.BookGenres)
                    {
                        <span class="badge bg-info">@genre.Genre.Name</span>
                    }
                </td>
                <td>@item.Publisher?.Name</td>
                <td>
                    <span class="badge @(item.Quantity > 0 ? "bg-success" : "bg-danger")">
                        @item.Quantity
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdBook" class="btn btn-info btn-sm">Подробности</a>
                    <a asp-action="Edit" asp-route-id="@item.IdBook" class="btn btn-warning btn-sm">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@item.IdBook" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>


                 

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📚 Каталог Книг</h1>
</div>

@* Форма поиска (будет отправляться GET-запросом) *@
<form asp-controller="Books" asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" 
               name="SearchString" 
               class="form-control" 
               placeholder="Поиск по названию, автору или аннотации..." 
               value="@ViewData["CurrentFilter"]" />
        <button class="btn btn-outline-primary" type="submit">Поиск</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <p class="alert alert-info">Книги не найдены или отсутствуют в каталоге.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            // Карточка книги
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @* Отображение авторов *@
                            @if (item.BookAuthors != null && item.BookAuthors.Any())
                            {
                                <span>Автор(ы): @string.Join(", ", item.BookAuthors.Select(ba => ba.Author.LastName))</span>
                            }
                            else
                            {
                                <span>Автор: Не указан</span>
                            }
                        </h6>
                        <p class="card-text small text-truncate" title="@item.Annotation">
                            @* Отображение части аннотации *@
                            @(item.Annotation != null && item.Annotation.Length > 100 ? item.Annotation.Substring(0, 100) + "..." : item.Annotation)
                        </p>
                        
                        <div class="mt-auto pt-2 border-top">
                            <p class="card-text mb-1">
                                <span class="fw-bold">В наличии:</span> 
                                @* Предполагается, что AvailableQuantity - это свойство, которое вы добавите в модель/ViewModel *@
                                @{
                                    var availableCount = item.Quantity - (item.BookLoans?.Count(bl => bl.ReturnDate == null) ?? 0);
                                }
                                <span class="@(availableCount > 0 ? "text-success" : "text-danger")">
                                    @availableCount из @item.Quantity
                                </span>
                            </p>

                            @* Кнопка бронирования *@@* Использование asp-action для вызова метода бронирования *@
                            <form asp-controller="Reservations" asp-action="Reserve" method="post" data-bookid="@item.IdBook">
                                <input type="hidden" name="BookId" value="@item.IdBook" />
                                <button type="submit" 
                                        class="btn btn-sm btn-primary w-100" 
                                        @(availableCount <= 0 ? "disabled" : "")>
                                    Забронировать
                                </button>
                                <small class="text-danger">
                                    @(availableCount <= 0 ? "Нет в наличии" : "")
                                </small>
                            </form>
                            
                            <a asp-action="Details" asp-route-id="@item.IdBook" class="btn btn-sm btn-outline-info w-100 mt-1">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>