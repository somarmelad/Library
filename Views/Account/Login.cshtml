@model Library2.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход в систему";
    Layout = "_Layout"; 
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-lg p-3 mt-5">
            <h2 class="card-title text-center text-primary">Вход в Библиотечную Систему</h2>
            <hr />
            <form asp-action="Login">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Login" class="control-label"></label>
                    <input asp-for="Login" class="form-control" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary w-100">Войти</button>
                </div>
            </form>

            <p class="mt-3 text-center text-muted small">
                Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}