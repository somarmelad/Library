@model IEnumerable<Library2.Models.Reader>

@{
    ViewData["Title"] = "Читатели";
}

<h1>Читатели</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить читателя</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Телефон</th>
            <th>Дата рождения</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LastName @item.FirstName @item.MiddleName</td>
                <td>@item.Phone</td>
                <td>@item.BirthDate?.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdReader" class="btn btn-info btn-sm">Подробности</a>
                    <a asp-action="Edit" asp-route-id="@item.IdReader" class="btn btn-warning btn-sm">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@item.IdReader" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>