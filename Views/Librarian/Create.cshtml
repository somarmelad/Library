@model Library2.Models.Book
@{
    ViewData["Title"] = "Добавить книгу";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="BookList" class="btn btn-outline-secondary btn-sm me-3 rounded-pill">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h2 fw-bold mb-0">Новое издание в каталог</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <h5 class="text-primary fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Общая информация</h5>

                                <div class="form-floating mb-3">
                                    <input asp-for="Title" class="form-control rounded-3" placeholder="Название книги" />
                                    <label asp-for="Title">Название книги</label>
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Издательство</label>
                                    <div class="input-group">
                                        <select asp-for="PublisherId" class="form-select rounded-start-3" asp-items="@ViewBag.Publishers">
                                            <option value="">-- Выберите издательство --</option>
                                        </select>
                                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPublisherModal">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="PublisherId" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Quantity" type="number" class="form-control rounded-3" placeholder="Кол-во" />
                                    <label asp-for="Quantity">Количество экземпляров</label>
                                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Annotation" class="form-label fw-semibold">Аннотация</label>
                                    <textarea asp-for="Annotation" class="form-control rounded-3" rows="6" placeholder="Краткое содержание..."></textarea>
                                    <span asp-validation-for="Annotation" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h5 class="text-primary fw-bold mb-3"><i class="bi bi-tags me-2"></i>Авторы и Жанры</h5>

                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-semibold mb-0">Выберите авторов</label>
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none" data-bs-toggle="modal" data-bs-target="#createAuthorModal">
                                            <i class="bi bi-person-plus"></i> Новый автор
                                        </button>
                                    </div>
                                    <select multiple="multiple" name="selectedAuthors" id="selectedAuthors" asp-items="@ViewBag.Authors" class="form-select multi-select-box shadow-sm" size="7"></select>
                                    <small class="text-muted"><i class="bi bi-info-circle"></i> Зажмите Ctrl, чтобы выбрать нескольких</small>
                                </div>

                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-semibold mb-0">Выберите жанры</label>
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none" data-bs-toggle="modal" data-bs-target="#createGenreModal">
                                            <i class="bi bi-plus-circle"></i> Новый жанр
                                        </button>
                                    </div>
                                    <select multiple="multiple" name="selectedGenres" id="selectedGenres" asp-items="@ViewBag.Genres" class="form-select multi-select-box shadow-sm" size="7"></select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow">
                                <i class="bi bi-check-lg me-2"></i>Сохранить книгу
                            </button>
                            <a asp-action="BookList" class="btn btn-light px-4 rounded-pill">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>