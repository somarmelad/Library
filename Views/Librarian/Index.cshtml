@{
    ViewData["Title"] = "Главная панель управления";
}

<div class="container mt-5">
    <h1 class="mb-4">Панель управления Библиотекаря</h1>

    <hr />

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Управление Книгами</h5>
                    <p class="card-text">Просмотр каталога, добавление, редактирование и удаление книг, а также управление авторами, жанрами и издателями.</p>
                    <a asp-controller="Librarian" asp-action="BookList" class="btn btn-primary mt-3">
                        Перейти к Книгам
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Управление Читателями</h5>
                    <p class="card-text">Просмотр списка всех зарегистрированных читателей. Добавление, редактирование, удаление и просмотр их истории.</p>
                    <a asp-controller="Readers" asp-action="Index" class="btn btn-success mt-3">
                        Перейти к Читателям
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Бронирования</h5>
                    <p class="card-text small">Заявки от читателей, подготовка книг к выдаче.</p>
                    <a asp-controller="Librarian" asp-action="Reservations" class="btn btn-info text-white mt-3 w-100">
                        Смотреть брони
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">Выдача / Возврат Книг</h5>
                    <p class="card-text">Управление активными выдачами: оформление новых выдач, прием возвращенных книг и управление бронированием.</p>
                    <a asp-controller="BookLoans" asp-action="Index" class="btn btn-warning mt-3">
                        Перейти к Выдачам
                    </a>
                </div>
            </div>
        </div>
        <div class="container mt-4">
            <h2 class="mb-4">Статистика библиотеки</h2>

            <div class="row">
                <div class="col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">
                            <i class="bi bi-bar-chart-line"></i> Популярные книги (за 30 дней)
                        </div>
                        <div class="card-body">
                            <canvas id="popularBooksChart" style="max-height: 400px;"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="list-group shadow-sm">
                        <a asp-action="BookList" class="list-group-item list-group-item-action">Управление книгами</a>
                        <a asp-action="Reservations" class="list-group-item list-group-item-action">Бронирования</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById('popularBooksChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
        const values = @Html.Raw(Json.Serialize(ViewBag.ChartValues));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Количество выдач',
                    data: values,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y', 
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}