@model Library2.Models.Book
@{
    ViewData["Title"] = "Детали книги";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-pill">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h2 fw-bold mb-0">Карточка книги</h1>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-4 bg-light p-4 border-end">
                <div class="text-center mb-4">
                    <div class="book-icon-placeholder mx-auto mb-3">
                        <i class="bi bi-book-half display-1 text-primary"></i>
                    </div>
                    <h3 class="fw-bold">@Model.Title</h3>
                    <p class="text-muted small">ID: @Model.IdBook</p>
                </div>

                <div class="stats-box rounded-3 p-3 bg-white border shadow-sm">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Всего:</span>
                        <span class="fw-bold text-dark">@Model.Quantity шт.</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Издатель:</span>
                        <span class="fw-bold text-primary">@Model.Publisher?.Name</span>
                    </div>
                </div>
            </div>

            <div class="col-md-8 p-4 p-md-5">
                <div class="mb-4">
                    <h5 class="fw-bold text-secondary border-bottom pb-2">Аннотация</h5>
                    <p class="text-dark lh-base mt-3" style="text-align: justify;">
                        @(string.IsNullOrEmpty(Model.Annotation) ? "Описание отсутствует." : Model.Annotation)
                    </p>
                </div>

                <div class="row">
                    <div class="col-sm-6 mb-4">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">Авторы</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.BookAuthors?.Any() == true)
                            {
                                @foreach (var ba in Model.BookAuthors)
                                {
                                    <span class="badge badge-author-detail">
                                        <i class="bi bi-person me-1"></i>@ba.Author.LastName @ba.Author.FirstName
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Не указаны</span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6 mb-4">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">Жанры</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.BookGenres?.Any() == true)
                            {
                                @foreach (var bg in Model.BookGenres)
                                {
                                    <span class="badge badge-genre-detail">@bg.Genre.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Не указаны</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-4 border-top">
                    <a asp-action="Edit" asp-route-id="@Model.IdBook" class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-pencil-square me-2"></i>Редактировать
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.IdBook" class="btn btn-outline-danger px-4 rounded-pill">
                        <i class="bi bi-trash me-2"></i>Удалить книгу
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>