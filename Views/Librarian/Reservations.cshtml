@model IEnumerable<Library2.Models.Reservation>

@{
    ViewData["Title"] = "Управление бронированиями";
}

<h1>Бронирования книг</h1>

<table class="table table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Книга</th>
            <th>Читатель</th>
            <th>Дата брони</th>
            <th>Истекает</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Book.Title</td>
                <td>@item.Reader.LastName @item.Reader.FirstName</td>

                @* Безопасный вывод даты бронирования *@
                <td>@item.ReservationDate.ToShortDateString()</td>

                @* Безопасный вывод даты истечения (так как она nullable) *@
                <td>@(item.ExpirationDate.HasValue? item.ExpirationDate.Value.ToShortDateString() : "—")</td>

                <td>
                    <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (item.Status == "Pending")
                    {
                        <form asp-action="ConfirmReservation" asp-route-id="@item.IdReservation" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary">Подтвердить</button>
                        </form>
                    }
                    else if (item.Status == "Ready")
                    {
                        <form asp-action="IssueReservation" asp-route-id="@item.IdReservation" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Выдать книгу</button>
                        </form>
                    }
                </td>
            </tr>
        
        }
    </tbody>
</table>