@model Library2.Models.Book
@{
    ViewData["Title"] = "Удалить книгу";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-danger text-white p-4 text-center">
                    <i class="bi bi-exclamation-octagon display-4 mb-2"></i>
                    <h2 class="fw-bold mb-0">Подтверждение удаления</h2>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="text-center text-muted mb-4">
                        Вы собираетесь удалить следующее издание. Это действие нельзя будет отменить.
                    </p>

                    <div class="deletion-details-box rounded-3 p-3 mb-4">
                        <h4 class="text-dark fw-bold mb-3 text-center">@Model.Title</h4>
                        <hr class="opacity-10">

                        <dl class="row mb-0 small">
                            <dt class="col-sm-4 text-muted">Издательство:</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.Publisher?.Name</dd>

                            <dt class="col-sm-4 text-muted">Количество:</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.Quantity шт.</dd>

                            <dt class="col-sm-4 text-muted">Авторы:</dt>
                            <dd class="col-sm-8">
                                @foreach (var author in Model.BookAuthors)
                                {
                                    <span class="badge bg-light text-dark border me-1">@author.Author.FullName</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">Жанры:</dt>
                            <dd class="col-sm-8">
                                @foreach (var genre in Model.BookGenres)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-1">@genre.Genre.Name</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" class="d-flex gap-2">
                        <input type="hidden" asp-for="IdBook" />
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-trash3 me-2"></i>Да, удалить
                        </button>
                        <a asp-action="BookList" class="btn btn-light w-100 rounded-pill py-2 fw-bold border">
                            Отмена
                        </a>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Если у книги есть активные выдачи, удаление может быть заблокировано системой.
                </small>
            </div>
        </div>
    </div>
</div>