@model IEnumerable<Library2.Models.Book>

@{
    ViewData["Title"] = "Каталог Книг";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Каталог Книг</h1>
</div>

@* Блок вывода уведомлений (успех или ошибка) *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Форма поиска *@
<form asp-controller="Reader" asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchString"
               class="form-control"
               placeholder="Поиск по названию, автору или аннотации..."
               value="@ViewData["CurrentFilter"]" />
        <button class="btn btn-outline-primary" type="submit">Поиск</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <p class="alert alert-info">Книги не найдены или отсутствуют в каталоге.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @if (item.BookAuthors != null && item.BookAuthors.Any())
                            {
                                <span>Автор(ы): @string.Join(", ", item.BookAuthors.Select(ba => ba.Author.LastName))</span>
                            }
                            else
                            {
                                <span>Автор: Не указан</span>
                            }
                        </h6>
                        <p class="card-text small text-truncate" title="@item.Annotation">
                            @(item.Annotation != null && item.Annotation.Length > 100 ? item.Annotation.Substring(0, 100) + "..." : item.Annotation)
                        </p>

                        <div class="mt-auto pt-2 border-top">
                            <p class="card-text mb-1">
                                <span class="fw-bold">В наличии:</span>
                                @{
                                    var resDict = ViewBag.ActiveReservations as Dictionary<int, int> ?? new Dictionary<int, int>();
                                    var myReservedIds = ViewBag.MyReservedIds as List<int> ?? new List<int>();

                                    int loanedCount = item.BookLoans?.Count(bl => bl.ReturnDate == null) ?? 0;

                                    int reservedCount = resDict.ContainsKey(item.IdBook) ? resDict[item.IdBook] : 0;

                                    int availableCount = item.Quantity - loanedCount - reservedCount;

                                    bool isAlreadyReservedByMe = myReservedIds.Contains(item.IdBook);
                                }
                                <span class="@(availableCount > 0 ? "text-success" : "text-danger")">
                                    @availableCount из @item.Quantity
                                </span>
                            </p>

                            <form asp-controller="Reader" asp-action="Reserve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="BookId" value="@item.IdBook" />

                                @if (isAlreadyReservedByMe)
                                {
                                    <button type="button" class="btn btn-sm btn-success w-100" disabled title="Вы уже забронировали эту книгу">
                                        <i class="bi bi-check-circle"></i> Забронировано вами
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-sm btn-primary w-100"
                                            @(availableCount <= 0 ? "disabled" : "")>
                                        @(availableCount <= 0 ? "Нет в наличии" : "Забронировать")
                                    </button>
                                }
                            </form>

                            <a asp-action="Details" asp-route-id="@item.IdBook" class="btn btn-sm btn-outline-info w-100 mt-1">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>