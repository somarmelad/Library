@model IEnumerable<Library2.Models.Book>

@{
    ViewData["Title"] = "Каталог Книг";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Каталог Книг</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="Reader" asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchString"
               class="form-control"
               placeholder="Поиск по названию, автору или аннотации..."
               value="@ViewData["CurrentFilter"]" />
        <button class="btn btn-outline-primary" type="submit">Поиск</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <p class="alert alert-info">Книги не найдены или отсутствуют в каталоге.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @if (item.BookAuthors != null && item.BookAuthors.Any())
                            {
                                <span>Автор(ы): @string.Join(", ", item.BookAuthors.Select(ba => ba.Author.LastName))</span>
                            }
                            else
                            {
                                <span>Автор: Не указан</span>
                            }
                        </h6>
                        <p class="card-text small text-truncate" title="@item.Annotation">
                            @(item.Annotation != null && item.Annotation.Length > 100 ? item.Annotation.Substring(0, 100) + "..." : item.Annotation)
                        </p>

                        <div class="mt-auto pt-2 border-top">
                            <p class="card-text mb-1">
                                @* ИСПРАВЛЕННАЯ ЛОГИКА СТАТУСА *@
                                @{
                                    // Проверяем, забронирована ли эта КОНКРЕТНАЯ книга текущим пользователем
                                    var myReservedIds = ViewBag.MyReservedIds as List<int> ?? new List<int>();
                                    bool isAlreadyReservedByMe = myReservedIds.Contains(item.IdBook);

                                    // Книга доступна, если её статус Available
                                    bool isAvailable = item.Status == BookStatus.Available;
                                }

                                <span class="fw-bold">Статус:</span>
                                @if (isAvailable)
                                {
                                    <span class="text-success">Свободна</span>
                                }
                                else if (isAlreadyReservedByMe)
                                {
                                    <span class="text-info">Забронирована вами</span>
                                }
                                else
                                {
                                    <span class="text-danger">Занята</span>
                                }
                                <br />
                                <small class="text-muted">Инв. №@item.IdBook</small>
                            </p>

                            <form asp-controller="Reservations" asp-action="Reserve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="BookId" value="@item.IdBook" />

                                @if (isAlreadyReservedByMe)
                                {
                                    <button type="button" class="btn btn-sm btn-success w-100" disabled>
                                        <i class="bi bi-check-circle"></i> Ожидает получения
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-sm btn-primary w-100"
                                            @(isAvailable ? "" : "disabled")>
                                        @(isAvailable ? "Забронировать" : "Недоступна")
                                    </button>
                                }
                            </form>

                            <a asp-action="Details" asp-route-id="@item.IdBook" class="btn btn-sm btn-outline-info w-100 mt-1">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>