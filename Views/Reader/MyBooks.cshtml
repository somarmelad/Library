@{
    ViewData["Title"] = "Моя история";
    var loans = ViewBag.Loans as List<Library2.Models.BookLoan> ?? new List<Library2.Models.BookLoan>();
    var reservations = ViewBag.Reservations as List<Library2.Models.Reservation> ?? new List<Library2.Models.Reservation>();
}

<div class="container mt-4">
    <h2>Личный кабинет (Читатель ID: @ViewData["DebugReaderId"])</h2>

    <div class="alert alert-info">
        Найдено выдач: @loans.Count | Найдено броней: @reservations.Count
    </div>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item shadow-sm">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-res">Мои брони (@reservations.Count)</button>
        </li>
        <li class="nav-item shadow-sm">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-loans">История выдач (@loans.Count)</button>
        </li>
    </ul>

    <div class="tab-content border-start border-end border-bottom p-3 bg-white">
        <div class="tab-pane fade show active" id="tab-res">
            @if (reservations.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Книга</th>
                            <th>Дата брони</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in reservations)
                        {
                            <tr>
                                <td>@(res.Book?.Title ?? "ID книги: " + res.BookId)</td>
                                <td>@res.ReservationDate.ToString("g")</td>
                                <td><span class="badge bg-warning text-dark">@res.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center p-4">У вас пока нет активных броней.</p>
            }
        </div>

        <div class="tab-pane fade" id="tab-loans">
            @if (loans.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Книга</th>
                            <th>Выдано</th>
                            <th>Возвращено</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in loans)
                        {
                            <tr>
                                <td>@(loan.Book?.Title ?? "Книга удалена")</td>
                                <td>@loan.LoanDate.ToShortDateString()</td>
                                <td>@(loan.ReturnDate?.ToShortDateString() ?? "На руках")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center p-4">История выдач пуста.</p>
            }
        </div>
    </div>
</div>