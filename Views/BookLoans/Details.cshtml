@model Library2.Models.BookLoan
@{
    ViewData["Title"] = "Подробности выдачи";
}

<h1>Подробности выдачи</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Книга
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>

        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Book.Annotation)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Book.Annotation)
        </dd>
      
        <dt class="col-sm-3">
            Читатель
        </dt>
        <dd class="col-sm-9">
            @Model.Reader.LastName @Model.Reader.FirstName @Model.Reader.MiddleName
        </dd>
        <dt class="col-sm-3">
            Сотрудник (Выдавший)
        </dt>
        <dd class="col-sm-9">
            @Model.Employee.LastName @Model.Employee.FirstName @Model.Employee.MiddleName
        </dd>
        <dt class="col-sm-3">
            Дата выдачи
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.LoanDate)
        </dd>
        <dt class="col-sm-3">
            Дата возврата
        </dt>
        <dd class="col-sm-9">
            @if (Model.ReturnDate.HasValue)
            {
                <span class="badge bg-success">@Html.DisplayFor(model => model.ReturnDate)</span>
            }
            else
            {
                <span class="badge bg-danger">Книга не возвращена</span>
            }
        </dd>
    </dl>
</div>
<div class="mt-3">
    
    <a asp-action="Edit" asp-route-id="@Model.IdBookLoan" class="btn btn-secondary">Изменить</a> |
    <a asp-action="Index" class="btn btn-light">Назад к списку</a>
</div>