@model IEnumerable<Library2.Models.BookLoan>
@{
    ViewData["Title"] = "Выданные книги";
}

<h1>Выданные книги</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Выдать новую книгу</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Book.Title)
            </th>
            <th>
                Читатель
            </th>
            <th>
                Сотрудник
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoanDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReturnDate)
            </th>
            <th>
                Статус
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Book.Title)
                </td>
                <td>
                    @item.Reader.LastName @item.Reader.FirstName
                </td>
                <td>
                    @item.Employee.LastName @item.Employee.FirstName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LoanDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReturnDate)
                </td>
                <td>
                    @if (item.ReturnDate == null)
                    {
                        <span class="badge bg-danger">ВЫДАНА</span>
                    }
                    else
                    {
                        <span class="badge bg-success">ВОЗВРАЩЕНА</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-secondary">
                        @(item.ReturnDate == null ? "Возврат / Изменить" : "Изменить")
                    </a>
                    <a asp-action="Details" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-info">Подробнее</a>
                    <a asp-action="Delete" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>