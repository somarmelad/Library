@model IEnumerable<Library2.Models.BookLoan>
@{
    ViewData["Title"] = "Выданные книги";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Журнал выдачи</h1>
            <p class="text-muted small mb-0">Учет выданных и возвращенных экземпляров</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Выдать новую книгу
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 border-0 text-uppercase small fw-bold text-muted">Книга</th>
                            <th class="border-0 text-uppercase small fw-bold text-muted">Участники</th>
                            <th class="border-0 text-uppercase small fw-bold text-muted text-center">Сроки</th>
                            <th class="border-0 text-uppercase small fw-bold text-muted text-center">Статус</th>
                            <th class="border-0 text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3" style="max-width: 250px;">
                                    <div class="fw-bold text-dark text-truncate">@item.Book.Title</div>
                                    <small class="text-muted">ID издания: #@item.BookId</small>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="small mb-1"><i class="bi bi-person text-primary me-2"></i>@item.Reader.LastName @item.Reader.FirstName</span>
                                        <span class="small text-muted"><i class="bi bi-person-badge me-2"></i>@item.Employee.LastName @item.Employee.FirstName</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="small fw-semibold">@item.LoanDate.ToString("dd.MM.yyyy")</div>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-arrow-right small"></i>
                                        @(item.ReturnDate?.ToString("dd.MM.yyyy") ?? "—")
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.ReturnDate == null)
                                    {
                                        <span class="badge badge-loaned">В работе</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-returned">Возвращена</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-white border" title="Изменить">
                                            <i class="bi @(item.ReturnDate == null ? "bi-arrow-left-right text-warning" : "bi-pencil text-secondary")"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-white border" title="Детали">
                                            <i class="bi bi-eye text-info"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdBookLoan" class="btn btn-sm btn-white border" title="Удалить">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>