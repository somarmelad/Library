@model Library2.Models.BookLoan
@{
    ViewData["Title"] = "Удаление выдачи";
}

<h1>Удаление выдачи</h1>

<h3>Вы уверены, что хотите удалить эту запись о выдаче?</h3>
<div>
    <h4>BookLoan</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Книга
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>
        <dt class="col-sm-3">
            Читатель
        </dt>
        <dd class="col-sm-9">
            @Model.Reader.LastName @Model.Reader.FirstName @Model.Reader.MiddleName
        </dd>
        <dt class="col-sm-3">
            Дата выдачи
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.LoanDate)
        </dd>
        <dt class="col-sm-3">
            Дата возврата
        </dt>
        <dd class="col-sm-9">
            @if (Model.ReturnDate.HasValue)
            {
                @Html.DisplayFor(model => model.ReturnDate)
            }
            else
            {
                <span class="text-danger">Книга не возвращена</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdBookLoan" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </form>
</div>