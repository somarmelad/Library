@model Library2.Models.Reader

@{
    ViewData["Title"] = "Удалить читателя";
    bool hasActiveLoans = Model.BookLoans.Any(bl => bl.ReturnDate == null);
}

<h1>Удалить читателя</h1>

@if (TempData["ActiveLoansError"] != null)
{
    <div class="alert alert-danger">
        @TempData["ActiveLoansError"]
    </div>
}

@if (ViewData["ActiveLoansError"] != null)
{
    <div class="alert alert-danger">
        <strong>Ошибка:</strong> @ViewData["ActiveLoansError"]
    </div>
}
else if (hasActiveLoans)
{
    <div class="alert alert-danger">
        <strong>ВНИМАНИЕ:</strong> Читателя невозможно удалить, пока у него есть невозвращенные книги!
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>ПРЕДУПРЕЖДЕНИЕ:</strong> Вы уверены, что хотите удалить этого читателя? Будут удалены все его записи о выдаче (@Model.BookLoans.Count() записей).
    </div>
}


<div>
    <h4>Читатель</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Фамилия
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            Имя
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class="col-sm-2">
            Отчество
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MiddleName)
        </dd>
        <dt class="col-sm-2">
            Активные выдачи
        </dt>
        <dd class="col-sm-10">
            @Model.BookLoans.Count(bl => bl.ReturnDate == null)
        </dd>
        <dt class="col-sm-2">
            Всего выдач
        </dt>
        <dd class="col-sm-10">
            @Model.BookLoans.Count()
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdReader" />

        @* Кнопка "Удалить" активна, только если НЕТ активных выдач *@
        <input type="submit"
               value="Удалить"
               class="btn btn-danger"
               @(hasActiveLoans ? "disabled" : "") />

        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>