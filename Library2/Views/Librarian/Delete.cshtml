@model Library2.Models.Book
@{
    ViewData["Title"] = "Списание экземпляра";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-danger text-white p-4 text-center">
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="text-center text-muted mb-4">
                        Вы собираетесь безвозвратно удалить данный экземпляр книги из фонда библиотеки.
                    </p>

                    <div class="deletion-details-box rounded-3 p-3 mb-4 bg-light border">
                        <h4 class="text-dark fw-bold mb-1 text-center">@Model.Title</h4>
                        <hr class="opacity-10">

                        <dl class="row mb-0 small">
                            <dt class="col-sm-5 text-muted">Текущий статус:</dt>
                            <dd class="col-sm-7 fw-bold">
                                @{
                                    var statusText = Model.Status switch
                                    {
                                        BookStatus.Available => "В наличии",
                                        BookStatus.Reserved => "Зарезервирована",
                                        BookStatus.Issued => "Выдана",
                                        _ => Model.Status.ToString()
                                    };
                                }
                                <span class="text-danger">@statusText.ToUpper()</span>
                            </dd>

                            <dt class="col-sm-5 text-muted">Издательство:</dt>
                            <dd class="col-sm-7">@Model.Publisher?.Name</dd>

                            <dt class="col-sm-5 text-muted">Авторы:</dt>
                            <dd class="col-sm-7">
                                @foreach (var author in Model.BookAuthors)
                                {
                                    <span class="badge bg-white text-dark border me-1">@author.Author.LastName</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    @if (Model.Status == BookStatus.Issued)
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>
                                <strong>Внимание!</strong> Книга числится как "Выдана". Списание выданной книги может нарушить отчетность.
                            </div>
                        </div>
                    }

                    <form asp-action="Delete" class="d-flex gap-2">
                        <input type="hidden" asp-for="IdBook" />
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-2"></i>Подтвердить списание
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-2 fw-bold border">
                            Отмена
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>