@{
    ViewData["Title"] = "Главная панель управления";
}

<div class="container mt-5">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary text-white p-3 rounded-3 me-3">
            <i class="bi bi-speedometer2 h2 mb-0"></i>
        </div>
        <h1 class="fw-bold mb-0">Панель управления</h1>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm librarian-card card-blue">
                <div class="card-body text-center d-flex flex-column">
                    <div class="icon-shape bg-primary-soft text-primary mb-3">
                        <i class="bi bi-book"></i>
                    </div>
                    <h5 class="card-title fw-bold">Книги</h5>
                    <p class="card-text text-muted small flex-grow-1">Каталог, авторы, жанры и управление фондом.</p>
                    <a asp-controller="Librarian" asp-action="BookList" class="btn btn-primary w-100 rounded-pill mt-3">Управлять</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm librarian-card card-green">
                <div class="card-body text-center d-flex flex-column">
                    <div class="icon-shape bg-success-soft text-success mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="card-title fw-bold">Читатели</h5>
                    <p class="card-text text-muted small flex-grow-1">База читателей, их история и редактирование данных.</p>
                    <a asp-controller="Readers" asp-action="Index" class="btn btn-success w-100 rounded-pill mt-3">Перейти</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm librarian-card card-info">
                <div class="card-body text-center d-flex flex-column">
                    <div class="icon-shape bg-info-soft text-info mb-3">
                        <i class="bi bi-bookmark-check"></i>
                    </div>
                    <h5 class="card-title fw-bold">Брони</h5>
                    <p class="card-text text-muted small flex-grow-1">Новые заявки и подготовка книг к выдаче.</p>
                    <a asp-controller="Librarian" asp-action="Reservations" class="btn btn-info text-white w-100 rounded-pill mt-3">Проверить</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm librarian-card card-orange">
                <div class="card-body text-center d-flex flex-column">
                    <div class="icon-shape bg-warning-soft text-warning mb-3">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                    <h5 class="card-title fw-bold">Выдача/Возврат</h5>
                    <p class="card-text text-muted small flex-grow-1">Оформление выдач и прием возвращенных книг.</p>
                    <a asp-controller="BookLoans" asp-action="Index" class="btn btn-warning text-white w-100 rounded-pill mt-3">Открыть</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-graph-up-arrow me-2 text-primary"></i> Популярные книги
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="popularBooksChart" style="height: 350px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold">Быстрые действия</h5>
                </div>
                <div class="list-group list-group-flush p-2">
                    <a asp-action="BookList" class="list-group-item list-group-item-action border-0 rounded-3 mb-1">
                        <i class="bi bi-plus-circle me-2 text-primary"></i> Добавить новую книгу
                    </a>
                    <a asp-action="Reservations" class="list-group-item list-group-item-action border-0 rounded-3 mb-1">
                        <i class="bi bi-clock-history me-2 text-info"></i> Очередь на бронь
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById('popularBooksChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
        const values = @Html.Raw(Json.Serialize(ViewBag.ChartValues));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Количество выдач',
                    data: values,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y', 
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}