@model IEnumerable<Library2.Models.Book>

@{
    ViewData["Title"] = "Управление Книгами";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Инвентарный список</h1>
        </div>
        <div class="btn-group">
            <a asp-action="Index" asp-controller="Librarian" class="btn btn-outline-secondary">
                <i class="bi bi-house-door"></i> В панель
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> Добавить экземпляры
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-admin-table">
                    <thead>
                        <tr>
                            <th class="ps-4">ID / Название</th>
                            <th>Авторы</th>
                            <th>Издательство</th>
                            <th class="text-center">Текущий статус</th>
                            <th class="text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Логика определения цвета для статуса
                            string statusClass = item.Status switch
                            {
                                BookStatus.Available => "success",
                                BookStatus.Reserved => "warning",
                                BookStatus.Issued => "danger",
                                _ => "secondary"
                            };

                            // Текстовое описание статуса (можно использовать Display attribute или просто текст)
                            string statusText = item.Status switch
                            {
                                BookStatus.Available => "В наличии",
                                BookStatus.Reserved => "Зарезервирована",
                                BookStatus.Issued => "Выдана",
                                _ => item.Status.ToString()
                            };

                            <tr>
                                <td class="ps-4">
                                    <small class="text-muted d-block">Инв. №@item.IdBook</small>
                                    <span class="fw-bold">@item.Title</span>
                                </td>
                                <td>
                                    @foreach (var author in item.BookAuthors)
                                    {
                                        <span class="badge badge-author">@author.Author.LastName</span>
                                    }
                                </td>
                                <td>@item.Publisher?.Name</td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-@statusClass" style="padding: 0.5em 1em; font-size: 0.85rem;">
                                        @statusText.ToUpper()
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IdBook" class="btn btn-light" title="Подробности">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdBook" class="btn btn-light text-warning" title="Редактировать статус">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdBook" class="btn btn-light text-danger" title="Списать экземпляр">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
