@model Library2.Models.Book

@{
    ViewData["Title"] = "Детали книги";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0 text-dark">
            <i class="bi bi-info-square-fill text-primary me-2"></i>Полная информация об издании
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Назад к списку
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-start mb-5">
                <div class="col-lg-8">
                    <h2 class="display-6 fw-bold text-dark mb-2">@Model.Title</h2>
                    <p class="text-muted lead mb-0">Издательство: <span class="text-primary fw-semibold">@Model.Publisher?.Name</span></p>

                    @* Добавлена информация о конкретном экземпляре *@
                    <div class="mt-2">
                        <span class="badge @(Model.Status == BookStatus.Available ? "bg-success" : "bg-warning") rounded-pill">
                            Статус этого экземпляра: @(Model.Status == BookStatus.Available ? "Свободен" : "Занят/Бронь")
                        </span>
                        <small class="text-muted ms-2">Инв. №@Model.IdBook</small>
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <div class="d-inline-block p-3 rounded-4 bg-light border">
                        <small class="d-block text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">Всего доступно таких книг</small>
                        @* ИСПРАВЛЕНО: Вместо Model.Quantity используем ViewBag *@
                        <span class="h4 fw-bold mb-0">@ViewBag.AvailableCount</span> <span class="text-muted">экз.</span>
                    </div>
                </div>
            </div>

            <hr class="my-4 opacity-10">

            <div class="row g-5">
                <div class="col-md-7">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-justify-left text-primary me-2"></i>Аннотация
                    </h5>
                    <div class="p-4 rounded-4 bg-light-subtle border border-light-subtle">
                        <p class="text-secondary lh-lg mb-0" style="text-align: justify; font-style: italic;">
                            @if (!string.IsNullOrEmpty(Model.Annotation))
                            {
                                @Model.Annotation
                            }
                            else
                            {
                                <span class="text-muted">Описание для данной книги отсутствует.</span>
                            }
                        </p>
                    </div>

                    @* Блок действий (Бронирование) *@
                    <div class="mt-4">
                        @if (Model.Status == BookStatus.Available)
                        {
                            @if (ViewBag.IsReservedByMe == true)
                            {
                                <div class="alert alert-info rounded-4">
                                    <i class="bi bi-check-circle-fill me-2"></i>Вы уже забронировали экземпляр этой книги.
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Reservations" asp-action="Reserve" method="post">
                                    <input type="hidden" name="BookId" value="@Model.IdBook" />
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                        <i class="bi bi-bookmark-plus me-2"></i>Забронировать этот экземпляр
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg rounded-pill px-5 disabled">
                                <i class="bi bi-x-circle me-2"></i>Экземпляр недоступен
                            </button>
                        }
                    </div>
                </div>

                <div class="col-md-5">
                    @* Секция авторов и жанров (без изменений) *@
                    <div class="mb-4">
                        <h6 class="text-uppercase fw-bold text-muted small mb-3 letter-spacing-1">Авторы</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.BookAuthors?.Any() == true)
                            {
                                @foreach (var ba in Model.BookAuthors)
                                {
                                    <div class="author-pill d-flex align-items-center bg-white border rounded-pill px-3 py-2 shadow-sm">
                                        <span class="author-name">@ba.Author.LastName @ba.Author.FirstName</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    @* ... (остальной код жанров) ... *@
                </div>
            </div>
        </div>
    </div>
</div>